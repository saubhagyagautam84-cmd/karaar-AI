# Copy to backend/.env to override. Every value below has a working default,
# so the app runs fully offline with no .env at all.

# --- DPI adapters (Step 3) ---
SPEECH_PROVIDER=mock          # mock | whisper | bhashini
TRANSLATE_PROVIDER=mock       # mock | bhashini | llm
PAYMENT_PROVIDER=mock         # mock | upi_intent
IDENTITY_PROVIDER=mock        # mock
ESHRAM_PROVIDER=mock          # mock
NOTIFY_PROVIDER=mock          # mock | twilio_whatsapp
DIGILOCKER_PROVIDER=mock      # mock
EDAAKHIL_PROVIDER=mock        # mock
LLM_PROVIDER=mock             # mock (offline rule engine) | anthropic (needs requirements-llm.txt + ANTHROPIC_API_KEY)
# LLM_MODEL=claude-opus-5-5

# --- Storage ---
# DB_PATH=data/karaar.db
# RECORDINGS_DIR=data/recordings

# Secret mixed into phone hashes. Change it for anything beyond a demo.
PHONE_HASH_SALT=karaar-dev-salt

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Region code used in agreement IDs (KA-2026-DL-00001) and the district new agreements default to.
ID_REGION=DL
DEFAULT_DISTRICT=South Delhi

# Base URL used in confirmation links sent to phones.
PUBLIC_BASE_URL=http://localhost:3000

# Demo mode: sample conversations, instant mock responses, and a reset button.
DEMO_MODE=true
