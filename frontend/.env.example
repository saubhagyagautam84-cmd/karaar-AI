# Leave empty to run in demo/mock mode (all AI + government APIs simulated in the browser).
# Point to the FastAPI backend to go live. "/backend" goes through this app's proxy (next.config.mjs),
# which also works from a phone on the same Wi-Fi; a full URL like http://localhost:8000 works too.
NEXT_PUBLIC_API_URL=/backend
# Where the proxy finds the FastAPI backend (server-side only).
BACKEND_URL=http://127.0.0.1:8000
# UPI VPA shown in payment intents during the demo
NEXT_PUBLIC_DEMO_UPI_VPA=karaar.demo@upi
